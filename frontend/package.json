    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
